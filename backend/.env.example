# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP del servidor
PORT=4000

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:3000

# Conexión a PostgreSQL (local con Docker; ver docker-compose.yml en la raíz)
DATABASE_URL=postgresql://forno:forno_dev_password@localhost:5432/forno_dev

# Base de datos de las pruebas (npm run test:db). El nombre debe terminar en «_test»: las pruebas
# vacían su esquema y nunca deben apuntar a desarrollo ni a producción.
DATABASE_URL_TEST=postgresql://forno:forno_dev_password@localhost:5432/forno_test

# URL del proyecto de Supabase (Project Settings > API). De ella salen el emisor de los tokens y
# su JWKS público: el backend verifica la firma de los access tokens sin necesitar ningún secreto.
# Sustituye el valor de ejemplo por el de tu proyecto (ver docs/security/supabase-auth.md).
SUPABASE_URL=https://your-project-ref.supabase.co

# Nivel de los registros: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Número de proxies de confianza delante de la API (0 = ninguno). En Railway: 1. Sin este valor
# correcto, el límite de peticiones por IP no distingue a los visitantes.
TRUST_PROXY=0

# Publica la documentación (/api/v1/docs y /api/v1/openapi.json). Por defecto: sí, salvo en producción.
# API_DOCS_ENABLED=true

# --- Fotos de producto (Supabase Storage) ---
# Clave secreta de Supabase (sb_secret_...). Solo hace falta para subir fotos desde el panel. Sin ella
# la subida responde 503 y los productos pueden usar la ruta o URL de una imagen. Nunca debe llegar
# al navegador ni a Flutter. Se crea en Supabase > Project Settings > API Keys.
# SUPABASE_SECRET_KEY=

# Bucket PÚBLICO de Storage donde se guardan las fotos (créalo en Supabase > Storage). Por defecto: products
# SUPABASE_STORAGE_BUCKET=products

# --- Demostración: «Hazte administrador» ---
# Permite que cada usuario se haga administrador desde «Mi cuenta» (y que aparezca la ventana que lo
# ofrece al entrar), para que cualquiera pueda probar todo el panel. Por defecto: ACTIVADO (la web es
# una demostración). En un negocio real ponlo en false: los roles los asigna un administrador.
# SELF_ADMIN_ENABLED=true
# Único correo que puede MODIFICAR la carta, las promociones, FORNEA CLUB y los ajustes del local. Los
# demás administradores ven esas secciones en modo lectura (botones desactivados y la API responde 403).
# Sin configurar, no hay restricción. Debe ser la dirección con la que te registras en la web.
# OWNER_EMAIL=tu-correo@ejemplo.com

# --- Pagos online (Stripe) ---
# Con las DOS claves el pago con tarjeta queda disponible; sin alguna, no se ofrece. Usa SIEMPRE claves
# de prueba (sk_test_...) mientras la web sea una demostración. Nunca deben llegar al navegador.
# La clave publicable (pk_test_...) NO hace falta: el pago se hace en la página de Stripe (Checkout).
# STRIPE_SECRET_KEY=
# Secreto del webhook (whsec_...). En local sale de `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`;
# en producción, del endpoint que se crea en el panel de Stripe (Developers > Webhooks).
# STRIPE_WEBHOOK_SECRET=
# URL pública de la web: a donde vuelve el cliente tras pagar. Por defecto, el primer valor de CORS_ORIGINS.
# FRONTEND_URL=http://localhost:3000

# --- Correo de pedidos ---
# log: los correos se redactan y se guardan sin enviar (se leen en el panel > Correos). Es lo habitual en la demo.
# resend: se envían con Resend (requiere RESEND_API_KEY).
EMAIL_DRIVER=log
# RESEND_API_KEY=
# Sin dominio verificado en Resend solo vale este remitente de pruebas.
# EMAIL_FROM=FORNO <onboarding@resend.dev>
# Si se indica, solo se envía a esa dirección (la de tu cuenta de Resend); al resto se les registra el aviso sin enviarlo.
# EMAIL_ONLY_TO=tu-correo@ejemplo.com

# --- PizzAI con inteligencia artificial (opcional) ---
# Clave de la API de Anthropic. Sin ella, PizzAI funciona en modo de demostración (respuestas fijas y
# rotuladas como provisionales). Con ella, el chat responde con IA usando solo los datos PÚBLICOS de la
# carta. Cada respuesta tiene un coste: fija un límite de gasto mensual en la consola del proveedor.
# Solo en el servidor; nunca en el frontend. Ver docs/decisions/0013-pizzai-ia.md.
# Opción gratuita para demostraciones: clave de Gemini (Google AI Studio, aistudio.google.com/apikey).
# Si está, tiene prioridad sobre la de Anthropic. El nivel gratuito tiene límites bajos y Google puede
# usar las conversaciones para mejorar sus productos (PizzAI solo envía datos públicos).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest
# ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5-5). Para una carta basta claude-haiku-5-5, mucho más barato.
# ASSISTANT_MODEL=claude-opus-5-5
# Máximo de mensajes al modelo por día entre todos los visitantes (tope de gasto). Por defecto: 200
# ASSISTANT_DAILY_LIMIT=200
