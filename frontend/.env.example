# URL base de la API del backend (sin barra final)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# URL pública de la web (para el sitemap y los metadatos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth (ver docs/security/supabase-auth.md). Solo la clave PÚBLICA («publishable»,
# sb_publishable_...), que es segura en el navegador. Nunca pongas aquí la clave secreta
# (sb_secret_...) ni la antigua service_role: darían control total sobre la base de datos.
# Si no se configuran, la web pública funciona y las páginas de acceso muestran un aviso.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
